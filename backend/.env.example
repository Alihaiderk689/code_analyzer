# Copy this file to .env and fill in real values. Never commit .env itself (see .gitignore).
# ENVIRONMENT toggles which DATABASE_URL_* is active; DEBUG is derived from it automatically.
ENVIRONMENT=development

# Django
SECRET_KEY=

# Development Database
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/dbname

# Production Database (Supabase)
DATABASE_URL_PROD=postgresql://user:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the frontend app; used to build links in auth emails (verify/reset).
FRONTEND_URL=http://localhost:5173

# Sender address for auth emails. If EMAIL_HOST_USER/EMAIL_HOST_PASSWORD below
# are left blank, emails print to the console instead of being sent, so this
# doesn't need to be a real inbox yet.
DEFAULT_FROM_EMAIL=noreply@codeanalyzer.local

# Optional: SMTP credentials to actually send auth emails (e.g. Gmail).
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it here (not your login password).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Groq API (https://console.groq.com/keys) - powers /api/analysis/{id}/suggestions|explanation|refactor
# and /api/ai/chat/.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Celery + Redis - powers async GitHub PR analysis (webhook -> queue -> analyze -> comment).
# Point both at your local Redis (brew services start redis / redis-server) for development.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to "true" only in tests/CI to run tasks synchronously without a broker.
CELERY_TASK_ALWAYS_EAGER=false

# GitHub integration - create an OAuth App at https://github.com/settings/developers.
# Authorization callback URL there must exactly match GITHUB_OAUTH_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/callback/
# Shared secret configured on each repo webhook; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# Base URL GitHub can reach to deliver webhooks (e.g. an ngrok URL in local dev).
GITHUB_WEBHOOK_BASE_URL=http://localhost:8000
# Fernet key encrypting stored GitHub access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
# Files larger than this (bytes) are skipped during PR analysis.
GITHUB_MAX_FILE_SIZE_BYTES=500000
