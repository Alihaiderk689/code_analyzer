# Copy this file to .env and fill in real values. Never commit .env itself (see .gitignore).
# ENVIRONMENT toggles which DATABASE_URL_* is active; DEBUG is derived from it automatically.
ENVIRONMENT=development

# Django
SECRET_KEY=

# Development Database
DATABASE_URL_DEV=postgresql://user:password@localhost:5432/dbname

# Production Database (Supabase)
DATABASE_URL_PROD=postgresql://user:password@host.pooler.supabase.com:6543/postgres?pgbouncer=true

ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: keys the HMAC that hashes registration OTP codes before they hit
# the database (accounts/otp.py). Leave blank to key it off SECRET_KEY, which
# is fine - set it only if you want to rotate OTP hashing separately. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_PEPPER_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL of the frontend app; used to build links in auth emails (verify/reset).
FRONTEND_URL=http://localhost:5173

# Only needed once frontend/backend are deployed on subdomains of one domain
# you own (e.g. api.example.com backend + app.example.com frontend, as with
# Render + Vercel) - makes the CSRF cookie visible to frontend JS across the
# subdomain boundary. Leave blank for local dev (same-site, different port).
# Must start with a dot: COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Brevo (transactional email - registration OTP codes + password reset links).
# Create an API key at https://app.brevo.com/settings/keys/api. Left blank,
# any email send raises a clear 503 rather than the app failing to boot.
BREVO_API_KEY=
# Must be a verified sender/domain in the Brevo account - see
# https://app.brevo.com/senders/list.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Code Analyzer

# AI provider chain - powers /api/analysis/{id}/suggestions|explanation|refactor
# and /api/ai/chat/. Groq is tried first; on any failure (rate limit reached,
# outage, missing key) it automatically falls back to Gemini, then to
# OpenRouter. All three are optional - leave a key blank to skip that provider.
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (https://aistudio.google.com/apikey) - "gemini-flash-latest" is a
# Google-maintained alias; pinning a dated snapshot risks 404s as it ages out
# of new-user/free-tier access.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# OpenRouter (https://openrouter.ai/keys) - "openrouter/auto" lets OpenRouter
# pick a model for you; set a specific model slug to pin one instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Per-provider timeout for the AI fallback chain (Groq -> Gemini -> OpenRouter).
# Worst case before a 503 is 3 x this value, and it must stay well below
# gunicorn's --timeout (120s, see backend/Dockerfile) - raise both together.
# Kept low (default 20, worst case 60s) so a slow chain has margin under a
# hosting platform's own proxy timeout (e.g. Render, which has no nginx in
# front of gunicorn to align timeouts with) - raising it without knowing that
# platform's real limit risks the connection being killed before gunicorn
# responds, which the frontend shows as a raw network failure instead of a
# clean 503. See config/settings.py's AI_REQUEST_TIMEOUT_SECONDS comment.
AI_REQUEST_TIMEOUT_SECONDS=20

# Optional: Redis URL for Django's cache (DRF throttle counters). Defaults to
# CELERY_BROKER_URL, which points at the same Redis. Left unset with no broker
# configured, the cache falls back to per-process memory and throttle limits
# become per-worker rather than global.
CACHE_REDIS_URL=

# Celery + Redis - powers async GitHub PR analysis (webhook -> queue -> analyze -> comment).
# Point both at your local Redis (brew services start redis / redis-server) for development.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to "true" only in tests/CI to run tasks synchronously without a broker.
CELERY_TASK_ALWAYS_EAGER=false

# Google Sign-In - create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with an Authorized
# JavaScript origin matching FRONTEND_URL above. Same value the frontend uses
# as VITE_GOOGLE_CLIENT_ID - OAuth client IDs aren't secret. No client secret
# needed here: this verifies Google ID tokens, it doesn't do a
# redirect/code-exchange flow.
GOOGLE_CLIENT_ID=

# GitHub integration - create an OAuth App at https://github.com/settings/developers.
# Authorization callback URL there must exactly match GITHUB_OAUTH_REDIRECT_URI below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/github/callback/
# Shared secret configured on each repo webhook; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=
# Base URL GitHub can reach to deliver webhooks (e.g. an ngrok URL in local dev).
GITHUB_WEBHOOK_BASE_URL=http://localhost:8000
# Fernet key encrypting stored GitHub access tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
# Files larger than this (bytes) are skipped during PR analysis.
GITHUB_MAX_FILE_SIZE_BYTES=500000
# Max files fetched when building a repository's dependency-graph index
# (see github_integration/services/repo_index_service.py).
GITHUB_MAX_INDEXED_FILES=300
# Total wall-clock seconds allowed for all GitHub fetches in one
# repository-context analysis (see github_integration/services/fetch_budget.py).
# Once spent, the context is returned truncated rather than the request being
# killed by gunicorn's --timeout 120. Must stay well under that timeout.
GITHUB_CONTEXT_FETCH_BUDGET_SECONDS=45
# Total wall-clock seconds for the WHOLE repository-context request - GitHub
# fetching plus the sandboxed runtime check, Bandit and the AI fallback chain,
# which run once per analyzed file (see core/execution_budget.py). Stages are
# skipped and the result flagged as degraded once it is spent, rather than the
# request being killed by gunicorn's --timeout 120. Must stay well under it.
GITHUB_CONTEXT_REQUEST_BUDGET_SECONDS=90
