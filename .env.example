# Copy this file to .env (repo root) before running `docker compose up`.
# Never commit .env itself (see .gitignore) - docker-compose.yml's `env_file: .env`
# on each service, plus the docker-compose.yml `environment:` overrides that
# point DATABASE_URL_DEV/CELERY_* at the `db`/`redis` service names regardless
# of what's set here (a non-Docker local dev .env might legitimately point
# those at localhost, which inside a container means "this container").
#
# This is a *different* file from backend/.env.example, which is for running
# the backend directly on your host (python manage.py runserver), not via Docker.

ENVIRONMENT=development

# Required - generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Postgres - used both by the `db` service itself and to build DATABASE_URL_DEV
# (see docker-compose.yml). Change the password before running this anywhere
# other than your own machine.
POSTGRES_DB=code_analyzer
POSTGRES_USER=code_analyzer
POSTGRES_PASSWORD=change-me

# Only read if you set ENVIRONMENT=production above (a real deployment, not
# local `docker compose up`) - see backend/.env.example for the format.
DATABASE_URL_PROD=

# FRONTEND_PORT: change if 80 is already taken on your machine. BACKEND_PORT
# is currently unused - the backend container has no port published to the
# host (see docker-compose.yml); everything, including the GitHub OAuth
# callback below, goes through nginx on FRONTEND_PORT instead. Kept here only
# in case you uncomment docker-compose.yml's backend `ports:` block for local
# direct-API debugging.
BACKEND_PORT=8000
FRONTEND_PORT=80

# Django - "backend" is the in-network service name nginx proxies to; add
# your real domain(s) here too if deploying this beyond localhost.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Optional: keys the HMAC that hashes registration OTP codes before they hit
# the database (accounts/otp.py). Leave blank to key it off SECRET_KEY, which
# is fine - set it only if you want to rotate OTP hashing separately. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_PEPPER_KEY=

CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

# Only needed if frontend/backend end up on genuinely separate deployments
# under subdomains of one domain you own (e.g. Render backend + Vercel
# frontend) rather than both behind this same nginx - see backend/.env.example
# for the full explanation. Must start with a dot: COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=

# Brevo (transactional email - registration OTP codes + password reset links).
# Create an API key at https://app.brevo.com/settings/keys/api.
BREVO_API_KEY=
# Must be a verified sender/domain in the Brevo account - see
# https://app.brevo.com/senders/list.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Code Analyzer

# AI provider chain - all optional, skipped if left blank. Groq tried first,
# falls back to Gemini then OpenRouter on any failure.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Per-provider timeout for the AI fallback chain (Groq -> Gemini -> OpenRouter).
# Worst case before a 503 is 3 x this value, and it must stay well below
# gunicorn's --timeout (120s, see backend/Dockerfile) - raise both together.
AI_REQUEST_TIMEOUT_SECONDS=30

# Optional: Redis URL for Django's cache (DRF throttle counters). Defaults to
# CELERY_BROKER_URL, which points at the same Redis. Left unset with no broker
# configured, the cache falls back to per-process memory and throttle limits
# become per-worker rather than global.
CACHE_REDIS_URL=

# Google Sign-In - create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, with an Authorized
# JavaScript origin matching FRONTEND_URL above. No client secret needed:
# this verifies Google ID tokens, it doesn't do a redirect/code-exchange flow.
GOOGLE_CLIENT_ID=

# GitHub integration - optional; endpoints that need these return a clear 503
# rather than the app failing to boot if left blank. Create an OAuth App at
# https://github.com/settings/developers - its callback URL must exactly
# match GITHUB_OAUTH_REDIRECT_URI below (goes through nginx -> backend, same
# as every other /api/ route - see frontend/nginx.conf).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost/api/github/callback/
GITHUB_WEBHOOK_SECRET=
# Must be a URL GitHub can actually reach (e.g. an ngrok tunnel, or your real
# deployed domain) - never localhost, which only means something on your own
# machine to GitHub's servers.
GITHUB_WEBHOOK_BASE_URL=http://localhost
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_MAX_FILE_SIZE_BYTES=500000
GITHUB_MAX_INDEXED_FILES=300
# Total wall-clock seconds allowed for all GitHub fetches in one
# repository-context analysis (see github_integration/services/fetch_budget.py).
# Once spent, the context is returned truncated rather than the request being
# killed by gunicorn's --timeout 120. Must stay well under that timeout.
GITHUB_CONTEXT_FETCH_BUDGET_SECONDS=45
# Total wall-clock seconds for the WHOLE repository-context request - GitHub
# fetching plus the sandboxed runtime check, Bandit and the AI fallback chain,
# which run once per analyzed file (see core/execution_budget.py). Stages are
# skipped and the result flagged as degraded once it is spent, rather than the
# request being killed by gunicorn's --timeout 120. Must stay well under it.
GITHUB_CONTEXT_REQUEST_BUDGET_SECONDS=90

# Baked into the frontend image at build time (Vite env vars are compile-time,
# not runtime) - relative by default so the built image works unmodified
# regardless of host/domain. Only change this if you're building the frontend
# to call a backend that ISN'T behind this same nginx (uncommon).
VITE_API_BASE_URL=/api
# Same Google OAuth Client ID as GOOGLE_CLIENT_ID above - also baked in at
# frontend build time.
VITE_GOOGLE_CLIENT_ID=
